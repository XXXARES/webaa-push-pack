<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application android:allowBackup="false" android:label="pushpack">
        <service android:name="com.webaa.pushpack.PushService" android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
        <provider
            android:name="com.webaa.pushpack.PushBoot"
            android:authorities="${applicationId}.webaapushboot"
            android:exported="false"
            android:initOrder="1" />
    </application>
</manifest>
